  <joint name="Joint2_R" type="revolute"><parent link="link1_R"/><child link="link2_R"/><origin xyz="0.12 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.6" upper="2.6" effort="100" velocity="2"/></joint>
  <joint name="Joint3_R" type="revolute"><parent link="link2_R"/><child link="link3_R"/><origin xyz="0.28 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.6" upper="2.6" effort="100" velocity="2"/></joint>
