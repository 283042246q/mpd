<?xml version="1.0"?>
<robot name="marvin_bimanual_mpd">
  <link name="base_link"/>
  <link name="base_L"/><link name="base_R"/>
  <joint name="mount_L" type="fixed"><parent link="base_link"/><child link="base_L"/><origin xyz="0 0.32 0.55" rpy="0 0 0"/></joint>
  <joint name="mount_R" type="fixed"><parent link="base_link"/><child link="base_R"/><origin xyz="0 -0.32 0.55" rpy="0 0 0"/></joint>
  <link name="link1_L"/><link name="link2_L"/><link name="link3_L"/><link name="link4_L"/><link name="link5_L"/><link name="link6_L"/><link name="flange_L"/>
